{
  "typeAcquisition": {
    "enable": true
  },
  "include": [
    "./src/**/*",
    "./scripts/**/*"
  ],
  "compilerOptions": {
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "allowUmdGlobalAccess": true,
    "lib": [
      "dom",
      "esnext"
    ],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "*": ["./typescript/node_modules/*"]
    }
  }
}
